{"title":"Mittlere Änderungsrate berechnen (2)","puid":"c-mat-11-analysis/x5nzeg","path":"/../c-mat-11-analysis/topic-03-01-mittlere-aenderungsrate/block-02-berechnen/level-07","type":"normal","voiceLang":"de","voice":"f8","instruction":{"text":"Berechne die mittlere Änderungsrate für das angegebene Intervall.","voice":"m3","speaker":true,"autoplay":false},"calculator":true,"hint":{"label":"Hilfe","text":[{"text":"<br><t-blue><m-blue>&nbsp;Tipp&nbsp;</m-blue></t-blue>&nbsp;Berechne die <mat>y</mat>-Werte, indem du die <mat>x</mat>-Werte des Intervalls in die Funktion einsetzt. Bilde dann aus diesen beiden Wertepaaren den Differenzenquotienten."},{"text":"<hr>"},{"text":"<br><t-yellow><m-yellow>&nbsp;Grundlagen&nbsp;</m-yellow></t-yellow>&nbsp;Teilt man für ein Intervall [&nbsp;x₁&#65279;;&nbsp;&#65279;x₂&nbsp;] einer Funktion <mat>f</mat> die Differenz der <mat>y</mat>-Werte durch die der <mat>x</mat>-Werte, erhält man die <b>mittlere Änderungsrate <mat>m</mat></b>: <mat center='true'>m=(y_2-y_1)/(x_2-x_1)</mat> Dieser Bruch (= „Quotient“) zweier Differenzen heißt <b>Differenzenquotient</b>."}]},"trainers":[{"trainer":"mathFormula","mode":"term","matLayout":{"specialKeys":"^ / ()"},"shuffleAtoms":true,"atoms":[{"a":"<mat center='true'>f(x)=2x^2,&nbsp;`[`-1`;`&nbsp;3]</mat><br><mat>m</mat>","b":"<mat>4</mat>","steps":{"correct":[{"value":"(2*3^2-2*(-1)^2)/(3-(-1))","info":"Löse die Potenzen auf."},{"value":"(18-2)/(3+1)","info":"Rechne die Terme aus."},{"value":"16/4","info":"Kürze den Bruch."}]},"sampleSolution":"<mat align='rcl'>\nm||=||(y_2-y_1)/(x_2-x_1)<br>\n ||=||(2*3^2-2*(-1)^2)/(3-(-1))<br>\n ||=||(18-2)/(3+1)<br>\n ||=||16/4<br>\n ||=||4\n</mat>"},{"a":"<mat center='true'>f(x)=x^3+5,&nbsp;`[`2`;`&nbsp;4]</mat><br><mat>m</mat>","b":"<mat>28</mat>","steps":{"correct":[{"value":"((4^3+5)-(2^3+5))/(4-2)","info":"Löse die Potenzen auf."},{"value":"((4^3+5)-(2^3+5))/2","info":"Löse die Potenzen auf."},{"value":"(69-13)/(4-2)","info":"Rechne die Terme aus."},{"value":"(69-13)/2","info":"Rechne den Zähler aus."},{"value":"56/(4-2)","info":"Rechne den Nenner aus."},{"value":"56/2","info":"Kürze den Bruch."}]},"sampleSolution":"<mat align='rcl'>\nm||=||(y_2-y_1)/(x_2-x_1)<br>\n ||=||((4^3+5)-(2^3+5))/(4-2)<br>\n ||=||(69-13)/(4-2)<br>\n ||=||56/2<br>\n ||=||4\n</mat>"},{"a":"<mat center='true'>f(x)=1/x+0.5,&nbsp;`[`1`;`&nbsp;8]</mat><br><mat>m</mat>","b":["<mat>-0.125</mat>","<mat>-1/8</mat>"],"steps":{"correct":[{"value":"((1/8+1/2)-(1/1+1/2))/(8-1)","info":"Rechne die Terme aus."},{"value":"((1/8+1/2)-(1/1+1/2))/7","info":"Rechne den Zähler aus."},{"value":"((1/8+1/2)-(1/1+1/2))/(8-1)","info":"Rechne die Terme aus."},{"value":"(5/8-12/8)/7","info":"Rechne den Zähler aus."},{"value":"(-7/8)/7","info":"Kürze den Bruch. Tipp: Multipliziere den Zähler mit dem Kehrwert des Nenners."},{"value":"(-7/8)*1/7","info":"Kürze und multipliziere aus."},{"value":"(-1/8)*1/1","info":"Multipliziere aus."},{"value":"(-1/8)*1","info":"Multipliziere aus."}]},"sampleSolution":"<mat align='rcl'>\nm||=||(y_2-y_1)/(x_2-x_1)<br>\n ||=||((1/x_2+1/2)-(1/x_1+1/2))/(x_2-x_1)<br>\n ||=||((1/8+1/2)-(1/1+1/2))/(8-1)<br>\n ||=||((1/8+4/8)-(8/8+4/8))/7<br>\n ||=||(5/8-12/8)/7<br>\n ||=||(-7/8)/7<br>\n ||=||-1/8=-0.125\n</mat>"},{"a":"<mat center='true'>f(x)=20x-25,&nbsp;`[`100`;`&nbsp;150]</mat><br><mat>m</mat>","b":"<mat>20</mat>","steps":{"correct":[{"value":"((20*150-25)-(20*100-25))/(150-100)","info":"Rechne die Terme aus."},{"value":"((20*150-25)-(20*100-25))/50","info":"Rechne den Zähler aus."},{"value":"1000/50","info":"Kürze den Bruch."}]},"sampleSolution":"<mat align='rcl'>\nm||=||(y_2-y_1)/(x_2-x_1)<br>\n ||=||((20*x_2-25)-(20*x_1-25))/(x_2-x_1)<br>\n ||=||((20*150-25)-(20*100-25))/(150-100)<br>\n ||=||1000/50<br>\n ||=||20\n</mat>"},{"a":"<mat center='true'>f(x)=x^2+x,&nbsp;`[`0`;`&nbsp;2]</mat><br><mat>m</mat>","b":"<mat>3</mat>","steps":{"correct":[{"value":"((2^2+2)-(0^2+0))/(2-0)","info":"Löse die Potenzen auf."},{"value":"(2^2+2)/2","info":"Löse die Potenz im Zähler auf."},{"value":"(6-0)/(2-0)","info":"Rechne die Terme aus."},{"value":"(4+2)/2","info":"Rechne den Zähler aus."},{"value":"6/2","info":"Kürze den Bruch."}]},"sampleSolution":"<mat align='rcl'>\nm||=||(y_2-y_1)/(x_2-x_1)<br>\n ||=||((x_2^2+2)-(x_1^2+0))/(x_2-x_1)<br>\n ||=||((2^2+2)-(0^2+0))/(2-0)<br>\n ||=||(6-0)/(2-0)<br>\n ||=||6/2<br>\n ||=||3\n</mat>"}]}],"parentTopic":{"title":"Mittlere Änderungsrate","path":"/../c-mat-11-analysis/topic-03-01-mittlere-aenderungsrate/topic","puid":"c-mat-11-analysis/jcxx2w"},"parentBlock":{"title":"Mittlere Änderungsrate berechnen","path":"/../c-mat-11-analysis/topic-03-01-mittlere-aenderungsrate/block-02-berechnen/block","puid":"c-mat-11-analysis/jzh56u"},"mediaFiles":{"sounds":[{"fileId":"sound/de/m3/Berechne die mittlere Änderungsrate für das angegebene Intervall.","etag":"e287-18384"}],"svgs":[],"lsgs":[],"images":[]},"etag":"b312-4952"}