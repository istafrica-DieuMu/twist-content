{"title":"The Till","puid":"c-eng-2-gb/xplfta","path":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/level-06","type":"normal","keyboardLayout":"standardNATENG","voiceLang":"en","voice":"m2_2025","instruction":{"voice":"f3_2025","speaker":true},"trainers":[{"trainer":"gapMulti","instruction":{"text":"Listen and write."},"gapMode":"write","design":"dialogue","soundMode":"askSound","lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/till.lsg","atoms":[{"b":"Good afternoon! Did you find everything for your ((++shop)) today?","sound":"Good afternoon! Did you find everything for your shop today?","voice":"f6_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/worker.lsg"}},{"b":"Yes, your colleagues were very helpful! Now, I’ve got all the ingredients to make ((++dinner)) for my family.","sound":"Yes, your colleagues were very helpful! Now, I’ve got all the ingredients to make dinner for my family.","voice":"f5_chirp","position":"left","person":{"lsg":"/../c-eng-2-gb/shared/students/ana.lsg"}},{"b":"Sounds lovely! Let’s get it all put through the ((till)) for you.","sound":"Sounds lovely! Let’s get it all put through the till for you.","voice":"f6_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/worker.lsg"}},{"b":"Sorry, I think there has been a mistake. I was told at the ((++bakery)) that the two small cakes were half ((++price))!","sound":"Sorry, I think there has been a mistake. I was told at the bakery that the two small cakes were half price!","voice":"f5_chirp","position":"left","person":{"lsg":"/../c-eng-2-gb/shared/students/ana.lsg"},"lsg":{"lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/till03.lsg","width":150}},{"b":"Whoops, my mistake! That should be 3 ((++pounds)) instead.","sound":"Whoops, my mistake. That should be 3 pounds instead.","voice":"f6_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/worker.lsg"}}]},{"trainer":"multipleChoice","instruction":{"text":"Choose."},"soundMode":"a","shuffleButtons":true,"onSamePage":true,"atoms":[{"a":"What is the discount on the cakes?","b":["++The cakes are half price.","There is no discount.","The cakes are 30% off."]},{"a":"What is the price of two cakes?","b":["Two cakes cost 1 pound and 50 pence.","Two cakes cost 5 pounds.","++Two cakes cost 3 pounds."]}]},{"trainer":"content","instruction":"Listen.","textAlign":"left","design":"dialogue","atoms":[{"lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/till.lsg"},{"text":"","sound":"So, your shop costs 13 pounds and 50 pence. Would you like to pay with cash or card?","speaker":true,"autoplay":true,"voice":"f6_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/worker.lsg"}},{"button":"Continue"},{"text":"","sound":"I only have a 20-pound note with me, so it has to be cash please.","speaker":true,"autoplay":true,"voice":"f5_chirp","position":"left","person":{"lsg":"/../c-eng-2-gb/shared/students/ana.lsg"}},{"button":"Continue"},{"text":"","sound":"No worries! Here is your change of 6 pounds and 50 pence.","speaker":true,"autoplay":true,"voice":"f6_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/worker.lsg"}},{"button":"Continue"},{"text":"","sound":"Thank you, have a good day!","speaker":true,"autoplay":true,"voice":"f5_chirp","position":"left","person":{"lsg":"/../c-eng-2-gb/shared/students/ana.lsg"}},{"button":"Continue"}]},{"trainer":"dragAndValidate","instruction":{"text":"Drag the correct amount of change."},"lsg":{"lsg":"/../c-eng-2-gb/topic-08-money-and-shopping/block-02-at-the-supermarket/lsg/purse.lsg","width":300},"validateMode":"sum650","zoneFlow":"center","onSamePage