:"m3"},"voiceLang":"de","shuffleButtons":true,"shuffleAtoms":false,"atoms":[{"b":"--oder schreiben Gabel das"},{"b":"--vielleicht groß unterschiedlich wir"},{"b":"--in sein besser weniger"},{"b":"--Igitt! Löhne wurden welche"},{"b":"--mittags schlau reden der"},{"b":"--weil staubig hoffen mein"}]},{"trainer":"buttons","hint":{"text":"<b>Substantive, Adjektive</b>, <b>Verben</b>, <b>Pronomen, Artikel</b> und <b>Numerale</b> gehören zu den flektierbaren Wortarten.","style":"avatar"},"instruction":{"text":"Finde das flektierbare (veränderbare) Wort.","sound":"Finde das flektierbare Wort.","voice":"m3"},"voiceLang":"de","shuffleButtons":true,"shuffleAtoms":false,"atoms":[{"b":"++Tasse in auf wegen"},{"b":"++lustig immer oh mit"},{"b":"++schütteln von daher aber"},{"b":"++ihr für eigentlich auch"},{"b":"++ein sehr trotz nur"},{"b":"++vier noch denn um"}]},{"trainer":"contentCard","instruction":"Schema zur Bestimmung von Wortarten:","atoms":{"b":"","lsg":{"lsg":"/../c-natdeu-8/topic-01-grammatik-wortarten-wortbildung/block-01-flektierbare-woerter/lsg/flektierbarkeit.lsg","width":450}}}],"parentTopic":{"title":"Grammatik – Wortarten, Wortbildung","path":"/../c-natdeu-8/topic-01-grammatik-wortarten-wortbildung/topic","puid":"c-natdeu-8/tmpi5x"},"parentBlock":{"title":"Flektierbare Wörter","path":"/../c-natdeu-8/topic-01-grammatik-wortarten-wortbildung/block-01-flektierbare-woerter/block","puid":"c-natdeu-8/qbq09w"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5/Ergänze die Lücken.","etag":"94b2-6166"},{"fileId":"sound/de/f5/Schiebe das Wort und seine flektierte Form zusammen.","etag":"a58a-15164"},{"fileId":"sound/de/m3/Finde das flektierbare Wort.","etag":"7af8-9652"},{"fileId":"sound/de/m3/Finde das nicht flektierbare Wort.","etag":"fc4a-11263"}],"svgs":[],"lsgs":[{"fileId":"lsg/c-natdeu-8/topic-01-grammatik-wortarten-wortbildung/block-01-flektierbare-woerter/lsg/flektierbarkeit.lsg","etag":"97f1-3038"}],"images":[{"fileId":"image/lsg_aa72cf82cf","etag":"40a2-18581","isBl