>abs(-22 - 8) = abs(-30) = 30</mat>"}},{"a":"<mat>-10</mat> und <mat>9</mat>","b":"Abstand: <mat><gap>19</gap></mat>","feedback":{"wrong":"<b>Abstandsrechnung:</b> <br><mat>abs(-10 - 9) = abs(-19) = 19</mat>"}},{"a":"<mat>-15</mat> und <mat>-12</mat>","b":"Abstand: <mat><gap>3</gap></mat>","feedback":{"wrong":"<b>Abstandsrechnung:</b> <br><mat>abs(-15 - (-12)) = abs(-3) = 3</mat>"}},{"a":"<mat>-35</mat> und <mat>9</mat>","b":"Abstand: <mat><gap>44</gap></mat>","feedback":{"wrong":"<b>Abstandsrechnung:</b> <br><mat>abs(-35 - 9) = abs(-44) = 44</mat>"}},{"a":"<mat>-4500</mat> und <mat>-4000</mat>","b":"Abstand: <mat><gap>500</gap></mat>","feedback":{"wrong":"<b>Abstandsrechnung:</b> <br><mat>abs(-4500 - (-4000)) = abs(-500) = 500</mat>"}},{"a":"<mat>-100</mat> und <mat>50</mat>","b":"Abstand: <mat><gap>150</gap></mat>","feedback":{"wrong":"<b>Abstandsrechnung:</b> <br><mat>abs(-100 - 50) = abs(-150) = 150</mat>"}}]}],"parentTopic":{"title":"Addition und Subtraktion","path":"/../c-mat-5/topic-02-addition-und-subtraktion/topic","puid":"c-mat-5/7cysov"},"parentBlock":{"title":"Addition und Subtraktion ganzer Zahlen","path":"/../c-mat-5/topic-02-addition-und-subtraktion/block-06-addition-und-subtraktion-ganzer-zahlen/block","puid":"c-mat-5/l1q899"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5/Berechne den Abstand der beiden Zahlen im Kopf.","etag":"33c6-14408"}],"svgs":[],"lsgs":[],"images":[]},"etag":"6e56-3433"}