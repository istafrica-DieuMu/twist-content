{"title":"Test","puid":"c-eng-2-gb/r5jw8p","path":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/level-test","type":"test","keyboardLayout":"standardNATENG","voiceLang":"en","voice":"f3_2025","instruction":{"voice":"m2_2025","speaker":true},"trainers":[{"trainer":"content","instruction":"Read.","textAlign":"left","design":"dialogue","atoms":[{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/04/classroom.lsg"},{"text":"Tell me about your family, Ana.","voice":"f1_chirp","position":"left","person":{"lsg":"/../c-eng-2-gb/shared/students/olivia.lsg"}},{"button":"Continue"},{"text":"There are six people in my family. They are me, my mum, my dad, my sister, my grandpa and my aunt.","voice":"f5_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/02/ana.lsg"}},{"button":"Continue"},{"text":"Do all of you live together?","voice":"f1_chirp","position":"left","person":{"lsg":"/../c-eng-2-gb/shared/students/olivia.lsg"}},{"button":"Continue"},{"text":"All of us live together except my aunt. She lives in another town.","voice":"f5_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/02/ana.lsg"}},{"button":"Continue"},{"text":"Is she the sister of your mum?","voice":"f1_chirp","position":"left","person":{"lsg":"/../c-eng-2-gb/shared/students/olivia.lsg"}},{"button":"Continue"},{"text":"No, she’s my dad’s sister.","voice":"f5_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/02/ana.lsg"}},{"button":"Continue"},{"text":"Is your grandpa the father of your mum or your dad?","voice":"f1_chirp","position":"left","person":{"lsg":"/../c-eng-2-gb/shared/students/olivia.lsg"}},{"button":"Continue"},{"text":"He’s the father of my mum. He has been living with us for two years.","voice":"f5_chirp","position":"right","person":{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/02/ana.lsg"}},{"button":"Continue"}]},{"trainer":"soundButtons","onSamePage":true,"instruction":{"text":"Listen and choose.","speaker":true},"shuffleButtons":true,"shuffleAtoms":false,"soundMode":"a","atoms":[{"a":"How many people are there in Ana’s family?","b":[{"sound":"There are six people in her family.","correct":true},{"sound":"There are seven people in her family."}]},{"a":"Does all of her family live together?","b":[{"sound":"No, her aunt lives in another town.","correct":true},{"sound":"No, her grandpa lives in another town."}]},{"a":"Whose father is Ana’s grandpa?","b":[{"sound":"He is her dad’s father."},{"sound":"He is her mum’s father.","correct":true}]}]},{"trainer":"dragSort","instruction":{"text":"Sort.","speaker":true},"atoms":[{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/test/dialogue1.lsg"},{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/test/dialogue2.lsg"},{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/test/dialogue3.lsg"},{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/test/dialogue4.lsg"},{"lsg":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/lsg/test/dialogue5.lsg"}]}],"parentTopic":{"title":"Home and Family","path":"/../c-eng-2-gb/topic-04-home-and-family/topic","puid":"c-eng-2-gb/tcuq53"},"parentBlock":{"title":"My Family","path":"/../c-eng-2-gb/topic-04-home-and-family/block-01-my-family/block","puid":"c-eng-2-gb/lb8p4j"},"mediaFiles":{"sounds":[{"fileId":"sound/en/f3_2025/Does all of her family live together?","etag":"1690-14156"},{"fileId":"sound/en/f3_2025/He is her dad’s father.","etag":"c1a4-9980"},{"fileId":"sound/en/f3_2025/He is her mum’s father.","etag":"d904-9980"},{"fileId":"sound/en/f3_2025/How many people are there in Ana’s family?","etag":"e83d-14588"},{"fileId":"sound/en/f3_2025/No, her aunt lives in another town.","etag":"7102-17468"},{"fileId":"sound/en/f3_2025/No, her grandpa lives in another town.","etag":"46be-17612