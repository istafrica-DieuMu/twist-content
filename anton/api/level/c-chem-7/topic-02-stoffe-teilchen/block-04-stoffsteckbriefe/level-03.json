/Wasser_kocht_nicht-1Ethanol_ja-hint-copyAT.lsg","width":200}},{"text":"<br><br>"},{"lsg":{"lsg":"/../c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-test/Wasser_kocht_1-hint-copyAT.lsg","width":200}}],"speaker":false},"groups":[{"groupId":1,"zone":"solvedzone1","solvedZone":"solvedzone1"},{"groupId":2,"zone":"solvedzone2","solvedZone":"solvedzone2"}],"dragElements":[{"elementCategory":"1","total":1,"lsg":{"lsg":"/../c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-test/kocht_frueher.lsg","width":119,"solvedWidth":119}},{"elementCategory":"2","total":1,"lsg":{"lsg":"/../c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-test/kocht_spaeter.lsg","width":119,"solvedWidth":119}}],"atoms":[{"groupId":1,"elementCategory":"1","total":1},{"groupId":2,"elementCategory":"2","total":1}]},{"trainer":"table","gapMode":"buttons","onSamePage":true,"shuffleButtons":true,"combineButtons":true,"removeCorrectButton":true,"rowHeader":true,"instruction":{"text":"Ordne die Stoffe jetzt korrekt zu."},"layout":"a1 b1\na2 b2","atoms":[{"id":"a1","b":"Stoff 1"},{"id":"b1","b":"((++Ethanol))"},{"id":"a2","b":"Stoff 2"},{"id":"b2","b":"((++Wasser))"}]},{"trainer":"dragAndValidate","instruction":{"text":"Ordne anhand deines bereits erworbenen Wissens die beiden Stoffe richtig zu.","speaker":true},"lsg":{"lsg":"/../c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-test/Eigenschaften_Wasser-und-Ethanol-unmarkiert.lsg","width":400},"validateMode":"group","finishButton":true,"maxPerZone":1,"atoms":[{"b":{"zone":"1"},"lsg":{"lsg":"/../c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-test/Ethanol.lsg","width":140}},{"b":{"zone":"2"},"lsg":{"lsg":"/../c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-test/Wasser.lsg","width":140},"continueButton":true}]}],"parentTopic":{"title":"Stoffe und Teilchen","path":"/../c-chem-7/topic-02-stoffe-teilchen/topic","puid":"c-chem-7/bmh385"},"parentBlock":{"title":"Stoffsteckbriefe","path":"/../c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/block","puid":"c-chem-7/xbhssy"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f8/Abgesehen von der Geruchsprobe, lassen sich die beiden Stoffe auch anhand ihrer elektrischen Leitfähigkeit unterscheiden.<br><br>Es wird mit <b>Stoff 1</b> begonnen.<br>Positioniere die Glühbirne korrekt im Stromkreis.","etag":"8914-76464"},{"fileId":"sound/de/f8/Besonders Stoffe, die man nicht sehen kann, zum Beispiel farblose Gase, sind schwer zu identifizieren. Für solche Stoffe gibt es spezielle Proben.","etag":"f7dc-66816"},{"fileId":"sound/de/f8/Das Experiment wird nun mit <b>Stoff 2</b> wiederholt.<br><br>Positioniere die Glühbirne korrekt im Stromkreis.","etag":"0a07-42192"},{"fileId":"sound/de/f8/Lies dir die <b>Auswertungen</b> durch und entscheide welche wahr ist und welche nicht.","etag":"da3a-32688"},{"fileId":"sound/de/f8/Lies dir die <b>Beobachtungen</b> durch und entscheide welche wahr ist und welche nicht.","etag":"cb95-32976"},{"fileId":"sound/de/f8/Nun führen wir die Glimmspanprobe durch.","etag":"a3fc-20736"},{"fileId":"sound/de/f8/Ordne anhand deines bereits erworbenen Wissens die beiden Stoffe richtig zu.","etag":"93fd-31824"},{"fileId":"sound/de/f8/Ordne deine Beobachtungen korrekt zu.","etag":"192c-21168"},{"fileId":"sound/de/f8/Ordne die Stoffe jetzt korrekt zu.","etag":"a7c1-19296"},{"fileId":"sound/de/f8/Schalte nun am Netzgerät den Strom an und schaue was passiert.","etag":"90ce-28368"},{"fileId":"sound/de/f8/Schalte nun an dem Netzgerät den Strom an und schaue was passiert.","etag":"472f-29088"},{"fileId":"sound/de/f8/Um herauszufinden ob sich Sauerstoff in einem Reagenzglas befindet, können wir die Glimmspanprobe heranziehen. Diese hilft uns dabei, Sauerstoff zu identifizieren.","etag":"cb17-73296"},{"fileId":"sound/de/f8/Was konntest du beobachten?","etag":"151c-15984"},{"fileId":"sound/de/f8/Wasser und Ethanol lassen sich gut an ihrem Geruch unterscheiden.<br>Schaue dir die Grafik an und ordne die Begriffe passend zu.","etag":"70e9-50400"},{"fileId":"sound/de/f8/Welche Schlussfolgerung kann man daraus ziehen?","etag":"e284-22320"},{"fileId":"sound/de/f8/Wie wird die Glimmspanprobe durchgeführt? Bringe die Schritte in die richtige Reihenfolge.","etag":"851b-41616"},{"fileId":"sound/de/f8/Ziehe den Holzspan nun zum Bunsenbrenner, um die Glimmspanprobe durchzuführen.","etag":"3449-35856"},{"fileId":"sound/de/f8/Ziehe nun den Glimmspan zum Reagenzglas und beobachte was passiert.","etag":"a338-31680"},{"fileId":"sound/de/m3/Anhand einfacher Experimente und Untersuchungen können Wasser und Ethanol voneinander unterschieden werden.","etag":"f997-24290"},{"fileId":"sound/de/m3/Beachte, dass die Beschriftungen von Stoff 1 und Stoff 2 bei jedem Experiment unterschiedlich sein können, du musst jedes Mal neu entscheiden, um welchen Stoff es sich handelt.","etag":"91bc-46659"},{"fileId":"sound/de/m3/Beachte, dass die Beschriftungen von Stoff 1 und Stoff 2 bei jedem Experiment unterschiedlich sein können. Du musst jedes Mal neu entscheiden, um welchen Stoff es sich handelt.","etag":"77d0-49287"},{"fileId":"sound/de/m3/Bei Raumtemperatur sind Wasser und Ethanol beides klare, farblose Flüssigkeiten. Auf den ersten Blick können sie nicht unterschieden werden.","etag":"c8e0-38588"},{"fileId":"sound/de/m3/Da Sauerstoff notwendig ist, damit Dinge brennen, und der Glimmspan im Reagenzglas erneut <b>zu brennen beginnt</b>, können wir daraus schließen, dass sich in diesem Reagenzglas <b>Sauerstoff</b> befindet.","etag":"e415-51053"},{"fileId":"sound/de/m3/Der Glimmspan beginnt erneut zu brennen.","etag":"b1e1-11444"},{"fileId":"sound/de/m3/Der glimmende Holzspan wird ausgepustet, sodass nur die Glut übrig bleibt.","etag":"4a12-23150"},{"fileId":"sound/de/m3/Der glimmende Holzspan wird vorsichtig in das zu testinde Gas eingeführt.","etag":"687a-22081"},{"fileId":"sound/de/m3/Ein Holzspan wird an einem Ende angezündet.","etag":"29ae-13863"},{"fileId":"sound/de/m3/Im Reagenzglas befindet sich Sauerstoff.","etag":"2887-13211"},{"fileId":"sound/de/m3/Im nächsten Experiment werden die beiden Stoffe gleichermaßen erhitzt, bis sie beide eine Temperatur von 100 °C erreicht haben.<br><br> Schaue dir den Versuchsablauf genau an.","etag":"a3f6-45728"}],"svgs":[{"fileId":"svg/c-svg/2017/02/21-officeItems_lupe.svg","etag":"a360-20078"},{"fileId":"svg/c-svg/2017/10/23-nose.svg","etag":"0af8-32290"},{"fileId":"svg/c-svg/2019/03/12-lightbulb02.svg","etag":"78dc-45813"},{"fileId":"svg/c-svg/2019/04/10-battery.svg","etag":"fb64-10254"},{"fileId":"svg/c-svg/2019/04/10-contact.svg","etag":"7aeb-237"},{"fileId":"svg/c-svg/2022/05/17-flame-01.svg","etag":"6829-1441"},{"fileId":"svg/c-svg/2022/12/22-star-2.svg","etag":"9dfb-526"},{"fileId":"svg/c-svg/2023/02/28-match-4.svg","etag":"5f7f-7487"},{"fileId":"svg/c-svg/2024/01/26-chemistry-tool-tubeEmpty01.svg","etag":"2dbd-2043"},{"fileId":"svg/c-svg/2024/02/02-chemistry-tool-bunsen-burner-03.svg","etag":"eb01-5138"},{"fileId":"svg/c-svg/2024/02/29-2019-03-12-lightbulb02-on.svg","etag":"029f-16913"},{"fileId":"svg/c-svg/2024/04/25-chemistry-tool-beaker01.svg","etag":"f518-1041"}],"lsgs":[{"fileId":"lsg/c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-03/Einfuehrung_Glimmspanprobe.lsg","etag":"d717-931"},{"fileId":"lsg/c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-03/bunsenbrenner.lsg","etag":"cce5-543"},{"fileId":"lsg/c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-03/glimmspan-copy.lsg","etag":"19e5-358"},{"fileId":"lsg/c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-03/glimmspan.lsg","etag":"dceb-414"},{"fileId":"lsg/c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-03/glimmspanprobe-1-copy.lsg","etag":"2b54-1900"},{"fileId":"lsg/c-chem-7/topic-02-stoffe-teilchen/block-04-stoffsteckbriefe/lsg/level-03/parent_holzspan-1.lsg","etag":"7e6e-740"},{"fileId":"lsg/c-