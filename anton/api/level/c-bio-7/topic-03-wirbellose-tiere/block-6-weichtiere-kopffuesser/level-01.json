er zu den Weichtieren. Sie heißen Kopffüßer, da ihre Gliedmaßen direkt vom Kopf ausgehen.","etag":"dd4a-39119"},{"fileId":"sound/de/m3/Schnecke","etag":"0b6e-3617"},{"fileId":"sound/de/m3/Sepia","etag":"a056-4006"},{"fileId":"sound/de/m3/Tigernacktschnecke","etag":"3516-6634"},{"fileId":"sound/de/m3/Viele Weichtiere leben im Wasser oder in feuchten Gebieten. Kopffüßer leben nur <b>im Salzwasser</b> der Meere und Ozeane.","etag":"18de-34094"},{"fileId":"sound/de/m3/Weinbergschnecke","etag":"9a4e-6061"}],"svgs":[],"lsgs":[{"fileId":"lsg/c-bio-7/topic-03-wirbellose-tiere/block-6-weichtiere-kopffuesser/lsg/coleoidea_intro.lsg","etag":"3fca-924"},{"fileId":"lsg/c-bio-7/topic-03-wirbellose-tiere/block-6-weichtiere-kopffuesser/lsg/dragMatch_bivalve2.lsg","etag":"d97a-132"},{"fileId":"lsg/c-bio-7/topic-03-wirbellose-tiere/block-6-weichtiere-kopffuesser/lsg/dragMatch_cephalopod2.lsg","etag":"c4f1-129"},{"fileId":"lsg/c-bio-7/topic-03-wirbellose-tiere/block-6-weichtiere-kopffuesser/lsg/dragMatch_gastropod2.lsg","etag":"d1b9-140"},{"fileId":"lsg/c-bio-7/topic-03-wirbellose-tiere/block-6-weichtiere-kopffuesser/lsg/intro_mollusca_2.lsg","etag":"57ef-351"},{"fileId":"lsg/c-bio-7/topic-03-wirbellose-tiere/block-6-weichtiere-kopffuesser/lsg/intro_sepia_nautilus.lsg","etag":"8583-1132"},{"fileId":"lsg/c-bio-7/topic-03-wirbellose-tiere/block-6-weichtiere-kopffuesser/lsg/mollusca_classification.lsg","etag":"e51a-2139"}],"images":[{"fileId":"image/adobe_106818125","etag":"cc07-157520","originalWidth":911,"originalHeight":500},{"fileId":"image/adobe_126212633_1","etag":"8c66-134470","originalWidth":521,"originalHeight":500},{"fileId":"image/adobe_126212633_4","etag":"5bcc-167027","originalWidth":626,"originalHeight":500},{"fileId":"image/adobe_141129924_circle","etag":"230f-452659","originalWidth":500,"originalHeight":500},{"fileId":"image/adobe_189996540","etag":"419d-106710","originalWidth":1763,"originalHeight":500},{"fileId":"image/adobe_189996540_animation1","etag":"ba30-73438","or