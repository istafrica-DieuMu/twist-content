Buttons":false,"shuffleAtoms":true,"soundMode":"b","atoms":[{"a":"hen","b":"((++hen’s hens’))","sound":"the hen’s eggs","lsg":"/../c-nateng-2-gb/topic-05d-vgp-punctuation/block-06-possessive-apostrophes/lsg/ChickenEggs.lsg"},{"a":"monkeys","b":"((monkey’s ++monkeys’))","sound":"the monkeys’ bananas","lsg":"/../c-nateng-2-gb/topic-05d-vgp-punctuation/block-06-possessive-apostrophes/lsg/Bananas.lsg"},{"a":"children","b":"((++children’s))","sound":"the children’s juice","feedback":{"end":"<b>Children</b> is an irregular plural noun and does not have an 's' at the end. This means that you add an apostrophe and an <b>'s'</b> to form the possessive."},"lsg":"/../c-nateng-2-gb/topic-05d-vgp-punctuation/block-06-possessive-apostrophes/lsg/Juice.lsg"},{"a":"lifeguard","b":"((++lifeguard’s lifeguards’))","sound":"the lifeguard’s sandcastle","lsg":"/../c-nateng-2-gb/topic-05d-vgp-punctuation/block-06-possessive-apostrophes/lsg/Sandcastle.lsg"},{"a":"adults","b":"((adult’s ++adults’))","sound":"the adults’ picnic","lsg":"/../c-nateng-2-gb/topic-05d-vgp-punctuation/block-06-possessive-apostrophes/lsg/Picnic.lsg"}]}],"parentTopic":{"title":"Vocabulary, Grammar and Punctuation - Punctuation","path":"/../c-nateng-2-gb/topic-05d-vgp-punctuation/topic","puid":"c-nateng-2-gb/5tgm3i"},"parentBlock":{"title":"Possessive Apostrophes","path":"/../c-nateng-2-gb/topic-05d-vgp-punctuation/block-06-possessive-apostrophes/block","puid":"c-nateng-2-gb/qc72mf"},"mediaFiles":{"sounds":[{"fileId":"sound/en/f3_2025/<b>Children</b> is an irregular plural noun and does not have an 's' at the end. This means that you add an apostrophe and an <b>'s'</b> to form the possessive.","etag":"35d3-51884"},{"fileId":"sound/en/f3_2025/To show possession, add an <b>apostrophe</b> followed by an <b>'s'</b>.<br> If the noun already ends in <b>'s'</b>, just add an apostrophe. This is also true for regular plural nouns.","etag":"3ff4-61965"},{"fileId":"sound/en/f3_2025/the adults’ picnic","etag":"9b4a-8252"},{"fileI