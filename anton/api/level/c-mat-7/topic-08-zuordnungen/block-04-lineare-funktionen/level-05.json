{"title":"Zuordnungsvorschrift finden","puid":"c-mat-7/8qxg0y","path":"/../c-mat-7/topic-08-zuordnungen/block-04-lineare-funktionen/level-05","type":"normal","minLevelPlayerVersion":"v1.2","voiceLang":"de","instruction":{"text":"Bestimme Stück für Stück die Zuordnungsvorschrift für die abgebildeten linearen Funktionen.","speaker":true,"voice":"f5"},"trainers":[{"trainer":"gapMulti","gapMode":"write","soundMode":"a","voice":"m3","gapValidateMode":"value","atoms":[{"a":"Wie lauten die Koordinaten der Punkte P<sub>1</sub> und P<sub>2</sub>?","b":"<mat>P_1 = (x_1|y_1) = (<gap>-2</gap>|<gap>-4</gap>)</mat> <br> <mat>P_2 = (x_2|y_2) = (<gap>1</gap>|<gap>5</gap>)</mat>","lsg":{"lsg":"/../c-mat-7/topic-08-zuordnungen/block-04-lineare-funktionen/lsg/function51.lsg","width":400}},{"a":"Nutze nun die Formel <br> <mat>m = (y_2 - y_1)/(x_2 - x_1)</mat>, <br> um die Steigung zu berechnen.","sound":"Nutze nun die Formel m ist gleich y 2 minus y 1 geteilt durch x 2 minus x 1 um die Steigung zu berechnen.","b":"<mat>m = (<gap>5</gap> - (<gap>-4</gap>))/(<gap>1</gap> - (<gap>-2</gap>)) = <gap>9</gap>/<gap>3</gap> = <gap>3</gap></mat>"},{"a":"Wie lautet der y-Achsenabschnitt <mat>b</mat>?","b":"<mat>b = <gap>2</gap></mat>"},{"a":"Wie lautet die dazugehörige Zuordnungsvorschrift?","b":"<mat>y = <gap>3</gap>* x <gap>+2</gap></mat>","gapValidateMode":"literal"}]},{"trainer":"gapMulti","gapMode":"write","soundMode":"a","voice":"m3","gapValidateMode":"value","atoms":[{"a":"Wie lauten die Koordinaten der Punkte P<sub>1</sub> und P<sub>2</sub>?","b":"<mat>P_1 = (x_1|y_1) = (<gap>-10</gap>|<gap>30</gap>)</mat> <br> <mat>P_2 = (x_2|y_2) = (<gap>20</gap>|<gap>15</gap>)</mat>","lsg":{"lsg":"/../c-mat-7/topic-08-zuordnungen/block-04-lineare-funktionen/lsg/function52.lsg","width":400}},{"a":"Nutze nun die Formel <br> <mat>m = (y_2 - y_1)/(x_2 - x_1)</mat>, <br> um die Steigung zu berechnen.","sound":"Nutze nun die Formel m ist gleich y 2 minus y 1 geteilt durch x 2 minus x 1 um die Steigung zu berechnen.","b":"<mat>m = (<gap>15</gap> - <gap>30</gap>)/(<gap>20</gap> - (<gap>-10</gap>)) = <gap>-15</gap>/<gap>30</gap> = <gap>-0.5</gap></mat>"},{"a":"Wie lautet der y-Achsenabschnitt <mat>b</mat>?","b":"<mat>b = <gap>25</gap></mat>"},{"a":"Wie lautet die dazugehörige Zuordnungsvorschrift?","b":"<mat>y = <gap>-0.5 -1/2</gap>* x <gap>+25</gap></mat>","gapValidateMode":"literal"}]},{"trainer":"gapMulti","gapMode":"write","soundMode":"a","voice":"m3","gapValidateMode":"value","atoms":[{"a":"Wie lauten die Koordinaten der Punkte P<sub>1</sub> und P<sub>2</sub>?","b":"<mat>P_1 = (x_1|y_1) = (<gap>0.5</gap>|<gap>-2</gap>)</mat> <br> <mat>P_2 = (x_2|y_2) = (<gap>-2</gap>|<gap>0.5</gap>)</mat>","lsg":{"lsg":"/../c-mat-7/topic-08-zuordnungen/block-04-lineare-funktionen/lsg/function53.lsg","width":400}},{"a":"Nutze nun die Formel <br> <mat>m = (y_2 - y_1)/(x_2 - x_1)</mat>, <br> um die Steigung zu berechnen.","sound":"Nutze nun die Formel m ist gleich y 2 minus y 1 geteilt durch x 2 minus x 1 um die Steigung zu berechnen.","b":"<mat>m = (<gap>0.5</gap> - (<gap>-2</gap>))/((<gap>-2</gap>) - <gap>0.5</gap>) = <gap>2.5</gap>/<gap>-2.5</gap> = <gap>-1</gap></mat>"},{"a":"Wie lautet der y-Achsenabschnitt <mat>b</mat>?","b":"<mat>b = <gap>-1.5</gap></mat>"},{"a":"Wie lautet die dazugehörige Zuordnungsvorschrift?","b":"<mat>y = <gap>-1</gap>* x <gap>-1.5 -3/2</gap></mat>","gapValidateMode":"literal"}]}],"parentTopic":{"title":"Zuordnungen","path":"/../c-mat-7/topic-08-zuordnungen/topic","puid":"c-mat-7/l1kbbc"},"parentBlock":{"title":"Lineare Funktionen","path":"/../c-mat-7/topic-08-zuordnungen/block-04-lineare-funktionen/block","puid":"c-mat-7/h8nj2u"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5/Bestimme Stück für Stück die Zuordnungsvorschrift für die abgebildeten linearen Funktionen.","etag":"671a-26479"},{"fileId":"sound/de/m3/Nutze nun die Formel m ist gleich y 2 minus y 1 geteilt durch x 2 minus x 1 um die Steigung zu berechnen.","etag":"a9cc-36878"},{"fileId":"sound/de/m