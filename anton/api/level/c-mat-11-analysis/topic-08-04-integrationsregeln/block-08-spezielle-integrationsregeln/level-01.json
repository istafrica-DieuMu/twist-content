{"title":"Einfache Stammfunktionen zuordnen","puid":"c-mat-11-analysis/s2qz8d","path":"/../c-mat-11-analysis/topic-08-04-integrationsregeln/block-08-spezielle-integrationsregeln/level-01","type":"normal","keyboardLayout":"standardDE","voiceLang":"de","voice":"m3_2025","instruction":{"voice":"f5_2025","speaker":true,"autoplay":false},"hint":{"label":"Hilfe","text":[{"text":"<m-yellow><t-yellow>&nbsp;Grundlagen&nbsp;</m-yellow></t-yellow>&nbsp;"},{"text":"Die Stammfunktion der <b>natürlichen Exponentialfunktion</b> entspricht der Exponentialfunktion selbst:<br><mat center=true>f(x)=e^x &nbsp;&nbsp;&nbsp;→&nbsp;&nbsp; F(x)=e^x</mat>"},{"text":"<hr><br>"},{"text":"Die Stammfunktion von <mat>1/x</mat> ist gegeben durch den Logarithmus des Betrags von <mat>x</mat>:<br><mat center=true>f(x)=1/x&nbsp;&nbsp;&nbsp;→&nbsp;&nbsp; F(x)=ln(abs(x))</mat>"},{"text":"<hr>"},{"text":"<br>Die Stammfunktionen der <b>trigonometrischen Funktionen</b> sind wieder trigonometrische Funktionen:<br><mat center=true> f(x)= <t-orange>sin(x)</t-orange> &nbsp;&nbsp;&nbsp;||→||&nbsp;&nbsp; F(x)=-<t-darkblue>cos(x)</t-darkblue><br>f(x)= <t-darkblue>cos(x)</t-darkblue> &nbsp;&nbsp;&nbsp;||→||&nbsp;&nbsp; F(x)=<t-orange>sin(x)</t-orange></mat>"}]},"trainers":[{"trainer":"listMatchVertical","shuffleAtoms":true,"instruction":{"text":"Ordne den Funktionen die passenden Stammfunktionen zu.","sound":"Ordne den Funktionen die passenden Stammfunktionen zu."},"atoms":[{"a":"<mat>f(x) = e^x</mat>","b":"<mat>F(x) = e^x</mat>"},{"a":"<mat>f(x) = 1/x</mat>","b":"<mat>F(x) = ln(abs(x))</mat>"},{"a":"<mat>f(x) = sin(x)</mat>","b":"<mat>F(x) = -cos(x)</mat>"},{"a":"<mat>f(x) = cos(x)</mat>","b":"<mat>F(x) = sin(x)</mat>"}]},{"trainer":"drawLines","instruction":{"text":"Verbinde jede Funktion mit ihrer korrekten Stammfunktion.","speaker":true,"autoplay":false},"lines":4,"pointToPoint":true,"lsg":{"width":500},"colors":["rgba(66,165,245,1)","rgba(255,167,38,1)","rgba(236,64,122,1)","rgba(171,71,188,1)"],"shuffleAtoms":false,"atoms":{"lsg":"/../c-mat-11-analysis/topic-08-04-integrationsregeln/block-08-spezielle-integrationsregeln/lsg/01/lineCombine-integration-01.lsg"}},{"trainer":"gap","gapMode":"buttons","instruction":{"text":"Gib die Stammfunktion mit Integrationskonstante 0 an."},"ignoreCase":false,"textAlign":"left","shuffleAtoms":true,"shuffleButtons":true,"matLayout":{"specialKeys":"cos abs sin ln e ^"},"atoms":[{"a":"<mat>f(x)=1/x</mat>","b":"<mat>F(x)=<gap>++ln(abs(x)) ln(x) x -1/{x^2}</gap></mat>"},{"a":"<mat>f(x)=sin(x)</mat>","b":"<mat>F(x)=<gap>sin(x) -sin(x) cos(x) ++-cos(x)</gap></mat>"},{"a":"<mat>f(x)=cos(x)</mat>","b":"<mat>F(x)=<gap>++sin(x) -sin(x) cos(x) -cos(x)</gap></mat>"},{"a":"<mat>f(x)=e^x</mat>","b":"<mat>F(x)=<gap>++e^x -e^x e^{-x} ln(x)</gap></mat>"}]}],"parentTopic":{"title":"Integrationsregeln","path":"/../c-mat-11-analysis/topic-08-04-integrationsregeln/topic","puid":"c-mat-11-analysis/30q4xw"},"parentBlock":{"title":"Spezielle Integrationsregeln","path":"/../c-mat-11-analysis/topic-08-04-integrationsregeln/block-08-spezielle-integrationsregeln/block","puid":"c-mat-11-analysis/bv6t6c"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5_2025/Gib die Stammfunktion mit Integrationskonstante 0 an.","etag":"47f2-15814"},{"fileId":"sound/de/f5_2025/Ordne den Funktionen die passenden Stammfunktionen zu.","etag":"25fd-14954"},{"fileId":"sound/de/f5_2025/Verbinde jede Funktion mit ihrer korrekten Stammfunktion.","etag":"dfa2-15396"}],"svgs":[],"lsgs":[{"fileId":"lsg/c-mat-11-analysis/topic-08-04-integrationsregeln/block-08-spezielle-integrationsregeln/lsg/01/lineCombine-integration-01.lsg","etag":"1b79-3123"},{"fileId":"lsg/c-renderer/math/renderer.lsr"}],"images":[]},"etag":"6623-3732"}