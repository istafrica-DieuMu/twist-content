er":"gapMulti","gapMode":"write","gapValidateMode":"value","uniqueSolutions":true,"lsg":{"lsg":"/../c-mat-9/topic-02-quadratische-gleichungen-funktionen/block-07-nullstellen-finden/lsg/findRoot_test1.lsg","width":400},"instruction":{"text":"Stelle die Funktion der verschobenen Normalparabel auf. Bestimme zunächst die Nullstellen."},"shuffleAtoms":false,"atoms":[{"b":"<b>Nullstellen:</b> <br><mat>x_1 = <gap>-1/2</gap> <br> x_2 = <gap>5</gap></mat>"},{"a":"<i>Nutze die Linearfaktorzerlegung.</i>","soundMode":"a","b":"<mat align='lcc'>f(x) ||=|| (<gap>x+1/2 x-5</gap>)(<gap>x+1/2 x-5</gap>)<br>||=|| <gap>x^2-9/2x-5/2</gap> </mat>","hint":{"text":"<b>Linearfaktorzerlegung:</b><br><mat>f(x) = (x-x_1)(x-x_2)</mat>"}}]},{"trainer":"imageButtons","hint":{"text":"<mat>f(x) = <t-blue>a</t-blue>(x-d)^2 + <t-purple>e</t-purple></mat><br><br><t-blue>a</t-blue> und <t-purple>e</t-purple> besitzen gleiches Vorzeichen:<br><i>keine Nullstellen</i><br><br><t-purple>e</t-purple> = 0:<br><i>eine Nullstelle</i><br><br><t-blue>a</t-blue> und <t-purple>e</t-purple> besitzen entgegengesetzte Vorzeichen:<br><i>zwei Nullstellen</i>"},"shuffleButtons":true,"instruction":{"text":"Welcher Graph passt zur folgenden Funktion?"},"lsg":{"width":150},"atoms":{"a":"<mat align=''>f(x) ||=|| <t-blue>-4</t-blue>(x+1)^2 + <t-purple>3</t-purple> <br>||=|| -4x^2 - 8x -1</mat>","b":[{"lsg":"/../c-mat-9/topic-02-quadratische-gleichungen-funktionen/block-07-nullstellen-finden/lsg/chooseGraph_2.lsg","correct":true},{"lsg":"/../c-mat-9/topic-02-quadratische-gleichungen-funktionen/block-07-nullstellen-finden/lsg/chooseGraph_3.lsg"}]}},{"trainer":"gapMulti","onSamePage":true,"gapMode":"write","gapValidateMode":"value","uniqueSolutions":true,"shuffleAtoms":false,"calculator":true,"instruction":{"text":"Bestimme rechnerisch die Nullstellen.<br><br><mat>f(x) = -4x^2-8x-1</mat>","sound":"Bestimme rechnerisch die Nullstellen der Funktion."},"atoms":[{"a":"<i>Welche Methode bietet sich zum Finden der Nullstellen an?</i>