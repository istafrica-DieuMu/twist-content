{"title":"Potenzen & Wurzeln – schwer","puid":"c-mat-9/2s3s05","path":"/../c-mat-9/topic-11-msa/block-01-zahlenbereiche/level-05","type":"test","voiceLang":"de","voice":"m3","instruction":{"voice":"f5"},"trainers":[{"trainer":"gap","gapMode":"write","instruction":{"text":"Fülle die Lücken.","speaker":true},"ignoreCase":false,"textAlign":"left","shuffleAtoms":true,"atoms":[{"a":"Gib ein n an, sodass gilt: <mat>10^n = 1000000</mat>","b":"<mat center='true'>n = <gap>6</gap></mat>"},{"a":"Gib ein n an, sodass gilt: <mat>4.3*10^n = 0.000043</mat>","b":"<mat center='true'>n = <gap>-5</gap></mat>"},{"a":"Gib ein n an, sodass gilt: <mat>rootn(1000000)=100</mat>","b":"<mat center='true'>n = <gap>3</gap></mat>"},{"a":"Gib ein n an, sodass gilt: <mat>rootn(16)=2</mat>","b":"<mat center='true'>n = <gap>4</gap></mat>"}]},{"trainer":"multipleChoice","instruction":{"text":"Wähle die richtige Antwort aus.","speaker":true},"shuffleAtoms":true,"atoms":[{"a":"<mat>sqrt(4^2+3^2)=</mat>","b":["++5","<mat>sqrt(7)</mat>","7"]},{"a":"<mat>(2+3)^3=</mat>","b":["++<mat>125</mat>","<mat>35</mat>","<mat>15</mat>"]},{"a":"Für welches a ist folgende Gleichung erfüllt: <mat>a^3=-125</mat>?","b":["<mat>5</mat>","++<mat>-5</mat>","<mat>25</mat>","<mat>-25</mat>"]},{"a":"Für welches a ist folgende Gleichung erfüllt: <mat>a^3=-125</mat>?","b":["<mat>5</mat>","++<mat>-5</mat>","<mat>25</mat>","<mat>-25</mat>"]}]},{"trainer":"gapMulti","gapMode":"write","shuffleAtoms":false,"instruction":{"text":"Schreibe die Potenz als Wurzelterm.","speaker":true},"gapValidateMode":"value","atoms":[{"b":"<mat>5^(4/13) = <gap>root13(5^4)</gap></mat>"},{"b":"<mat>15^(2/5) = <gap>root5(15^2)</gap></mat>"},{"b":"<mat>10^(5/6) = <gap>root6(10^5)</gap></mat>"}]},{"trainer":"mathFormula","instruction":{"text":"Berechne.","speaker":true},"mode":"term","atoms":[{"a":"<mat>root3((16^2*sqrt(16))/(2^3*sqrt(4)))</mat>","b":"<mat>4</mat>","matLayout":{"specialKeys":"root /"},"sampleSolution":"<i>Aufgabe:</i><br>\n<mat>root3((16^2*sqrt(16))/(2^3*sqrt(4)))</mat><br><br>\n<i>Berechne die inneren Wurzeln:</i><br>\n<mat>= root3((16^2*4)/(2^3*2))</mat><br><br>\n<i>Schreibe alle Zahlen als Zweierpotenzen:</i><br>\n<mat>= root3(((2^4)^2*2^2)/(2^4))</mat><br><br>\n<i>Kürze mit <mat>2^4</mat>:</i><br>\n<mat>= root3(2^4*2^2)</mat><br><br>\n<i>Fasse zusammen:</i><br>\n<mat>= root3(2^6)=2^(6/3)</mat><br><br>\n<i>Rechne aus:</i><br>\n<mat>= 2^2=4</mat><br><br>"},{"a":"<mat>sqrt((12^2-(sqrt(49)*3^2))/2^6)</mat>","b":"<mat>9/8</mat>","matLayout":{"specialKeys":"sqrt ^ / ()"},"steps":{"correct":{"syntax":"$/$^$","info":"Rechne die Potenz aus."}},"sampleSolution":"<i>Aufgabe:</i><br>\n<mat>sqrt((12^2-(sqrt(49)*3^2))/2^6)</mat><br><br>\n<i>Schreibe die Wurzel und die Potenz in der Klammer aus:</i><br>\n<mat>= sqrt((12^2-(7*9))/2^6)</mat><br><br>\n<i>Multipliziere das Produkt und berechne die Potenz im Zähler:</i><br>\n<mat>= sqrt((144-(63))/2^6)</mat><br><br>\n<i>Fasse den Zähler zusammen und berechne die Potenz im Nenner:</i><br>\n<mat>= sqrt(81/64)</mat><br><br>\n<i>Wende das Wurzelgesetz an:</i><br>\n<mat>= sqrt(81)/sqrt(64)</mat><br><br>\n<i>Rechne aus:</i><br>\n<mat>= 9/8</mat><br><br>"}]}],"parentTopic":{"title":"Mittlerer Schulabschluss","path":"/../c-mat-9/topic-11-msa/topic","puid":"c-mat-9/24m4i4"},"parentBlock":{"title":"Zahlenbereiche","path":"/../c-mat-9/topic-11-msa/block-01-zahlenbereiche/block","puid":"c-mat-9/zh1ezh"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5/Berechne.","etag":"2f9c-3822"},{"fileId":"sound/de/f5/Fülle die Lücken.","etag":"98f7-4994"},{"fileId":"sound/de/f5/Schreibe die Potenz als Wurzelterm.","etag":"b823-12279"},{"fileId":"sound/de/f5/Wähle die richtige Antwort aus.","etag":"1b1a-11158"}],"svgs":[],"lsgs":[],"images":[]},"etag":"2b62-3779"}