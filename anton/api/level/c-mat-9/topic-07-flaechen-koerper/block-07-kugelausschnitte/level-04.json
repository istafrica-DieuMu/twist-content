8.90</gap> `cm`^2</mat>"},{"a":"Zuletzt addiert man beide Flächen:","b":"<mat center='true' align='rl'>O_`Aus`||=O_1+O_2<br>||=21.11 `cm`^2 + 18.91 `cm`^2<br>||=<gap>40.02</gap> `cm`^2</mat>","lsg":"/../c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/lsg/04/03.lsg"}]}],"parentTopic":{"title":"Flächen & Körper","path":"/../c-mat-9/topic-07-flaechen-koerper/topic","puid":"c-mat-9/jgutuf"},"parentBlock":{"title":"Kugelausschnitte","path":"/../c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/block","puid":"c-mat-9/r8q83s"},"mediaFiles":{"sounds":[{"fileId":"sound/de/m3/Berechne den Oberflächeninhalt des abgebildeten Kugelausschnitts. Runde Zwischenergebnisse auf zwei Nachkommastellen.","etag":"6d6c-34439"},{"fileId":"sound/de/m3/Fülle die Lücken.","etag":"0f29-5125"}],"svgs":[],"lsgs":[{"fileId":"lsg/c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/lsg/04/01.lsg","etag":"c5f3-1298"},{"fileId":"lsg/c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/lsg/04/02.lsg","etag":"46ba-1436"},{"fileId":"lsg/c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/lsg/04/02b.lsg","etag":"4f2c-1436"},{"fileId":"lsg/c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/lsg/04/03.lsg","etag":"008c-690"},{"fileId":"lsg/c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/lsg/04/05.lsg","etag":"27ee-1300"},{"fileId":"lsg/c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/lsg/04/06.lsg","etag":"be1f-693"},{"fileId":"lsg/c-mat-9/topic-07-flaechen-koerper/block-07-kugelausschnitte/lsg/04/09.lsg","etag":"9d2f-2839"},{"fileId":"lsg/c-renderer/angle/renderer.lsr"}],"images":[]},"etag":"14dd-3705"}