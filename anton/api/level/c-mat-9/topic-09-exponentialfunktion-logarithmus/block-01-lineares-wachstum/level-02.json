es</b> Wachstum (Zunahme)<br><mat>d&lt;0:</mat> <b>negatives</b> Wachstum (Abnahme)<br><mat>d=0:</mat> <b>kein</b> Wachstum (Stagnation)","label":"Absolute Änderung"},"gapMode":"write","gapValidateMode":"value","instruction":{"text":"Berechne die absolute Änderung."},"atoms":[{"a":"Zeitpunkt 1 → Zeitpunkt 2","b":"<mat center='true'>d_(1→2) = 132€ - <gap>105</gap>€ = <gap>27</gap>€</mat>"},{"b":"Das <b>Wachstum</b> ist ((++positiv --negativ --stagniert)).","gapMode":"buttons","shuffleButtons":true}]},{"trainer":"gapMulti","lsg":"/../c-mat-9/topic-09-exponentialfunktion-logarithmus/block-01-lineares-wachstum/lsg/table_Limo.lsg","hint":{"text":"<mat>d = `Bestand`_(`später`)- `Bestand`_(`früher`)</mat><br><br><mat>d&gt;0:</mat> <b>positives</b> Wachstum (Zunahme)<br><mat>d&lt;0:</mat> <b>negatives</b> Wachstum (Abnahme)<br><mat>d=0:</mat> <b>kein</b> Wachstum (Stagnation)","label":"Absolute Änderung"},"gapMode":"write","gapValidateMode":"value","instruction":{"text":"Berechne die absolute Änderung."},"atoms":[{"a":"Zeitpunkt 2 → Zeitpunkt 3","b":"<mat center='true'>d_(2→3) = 110€ - <gap>132</gap>€ = <gap>-22</gap>€</mat>"},{"b":"Das <b>Wachstum</b> ist ((--positiv ++negativ --stagniert)).","gapMode":"buttons","shuffleButtons":true}]},{"trainer":"gapMulti","lsg":"/../c-mat-9/topic-09-exponentialfunktion-logarithmus/block-01-lineares-wachstum/lsg/table_Limo.lsg","hint":{"text":"<mat>d = `Bestand`_(`später`)- `Bestand`_(`früher`)</mat><br><br><mat>d&gt;0:</mat> <b>positives</b> Wachstum (Zunahme)<br><mat>d&lt;0:</mat> <b>negatives</b> Wachstum (Abnahme)<br><mat>d=0:</mat> <b>kein</b> Wachstum (Stagnation)","label":"Absolute Änderung"},"gapMode":"write","gapValidateMode":"value","instruction":{"text":"Berechne die absolute Änderung."},"atoms":[{"a":"Zeitpunkt 3 → Zeitpunkt 4","b":"<mat center='true'>d_(3→4) = <gap>214</gap>€ - <gap>110</gap>€ = <gap>104</gap>€</mat>"},{"b":"Das <b>Wachstum</b> ist ((++positiv --negativ --stagniert)).","gapMode":"buttons","shuffleButtons":tr