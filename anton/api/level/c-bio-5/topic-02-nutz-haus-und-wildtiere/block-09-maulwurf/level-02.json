{"title":"Körperbau","puid":"c-bio-5/zs8df6","path":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/level-02","type":"normal","voiceLang":"de","voice":"m3","instruction":{"voice":"f5","speaker":true},"trainers":[{"trainer":"lsg","gapMode":"buttons","finishButton":false,"instruction":{"speaker":true,"text":"Beschrifte das Skelett des Maulwurfs."},"shuffleButtons":true,"soundMode":"b","lsg":{"lsg":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Skelett-LSG.lsg","width":300},"atoms":[{"id":"Wirbelsäule","b":"((++Wirbelsäule Kniescheibe))"},{"id":"Schädel","b":"((Becken ++Schädel))"},{"id":"Handknochen","b":"((++Handknochen Fußknochen))"},{"id":"Rippen","b":"((Finger ++Rippen))"},{"id":"Beinknochen","b":"((++Beinknochen Kiefer))"}]},{"trainer":"multipleChoice","instruction":{"text":"Wähle alle richtigen Aussagen aus.","speaker":true},"onSamePage":true,"hint":{"text":"Es können mehrere Antworten richtig sein.","speaker":true},"atoms":{"b":["++Der Schädel des Maulwurfs ist kegelförmig.","Der Schädel des Maulwurfs ist kreisrund.","Die Füße des Maulwurfs sind deutlich größer als die Hände.","++Die Hände des Maulwurfs sind deutlich größer als die Füße."]}},{"trainer":"multipleChoice","instruction":{"text":"Wie kann man die Körperform des Maulwurfs am ehesten beschreiben?","speaker":true},"image":{"image":"adobe_5839047_01","width":200},"hint":{"text":{"lsg":{"lsg":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/01_Walze_Kugel_Wuerfel.lsg","width":250}},"style":"avatar"},"atoms":{"b":["++walzenförmig","kugelförmig","würfelförmig"]}},{"trainer":"multipleChoiceText","instruction":{"text":"Lies den Text und beantworte die Fragen.","speaker":true},"soundMode":"a","atoms":[{"title":"Körperbau des Maulwurfs"},{"lsg":{"lsg":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Hand.lsg","width":250}},{"text":"Der <b>walzenförmige Körper</b> des Maulwurfs ist an das Leben in den engen Bodengängen angepasst. Das gilt auch für seine Hände. Neben den fünf Fingerknochen verbreitert ein zusätzlicher Knochen, das <span class=a><b>Sichelbein</b></span>, die Handfläche. So kann der Maulwurf <span class=b>mehr Erde auf einmal schaufeln.</span>","speaker":true},{"a":"Wie nennt man den zusätzlichen Knochen an der Hand des Maulwurfs?","b":["++Sichelbein","Sichelarm","Sichelfinger"],"highlightSpanClass":"a"},{"a":"Wozu dient das Sichelbein?","b":["Es sorgt dafür, dass der Maulwurf schneller laufen kann.","++Es verbreitert die Handfläche, sodass der Maulwurf mehr Erde schaufeln kann.","Es funktioniert wie ein Stachel, der im Kampf gegen Feinde eingesetzt werden kann."],"highlightSpanClass":"b"}]},{"trainer":"findZone","correctIconType":"check","instruction":{"text":"Klicke auf das Sichelbein.","speaker":true},"lsg":{"lsg":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Hand-copy.lsg","width":250},"atoms":{"class":"Sichelbein"}},{"trainer":"multipleChoiceText","instruction":{"text":"Lies den Text und beantworte die Fragen.","speaker":true},"soundMode":"a","atoms":[{"lsg":{"lsg":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Gebiss.lsg","width":250}},{"text":"Der Maulwurf hat ein typisches <b>Insektenfressergebiss</b>. Mit den auffällig großen <span class=a><b>Eckzähnen</b></span> tötet er seine Beute, zu der vor allem <b>Regenwürmer</b> gehören. Mit den spitzen Backenzähnen zerkleinert er sie dann, bevor er sie schluckt.","speaker":true},{"a":"Womit tötet der Maulwurf seine Beute?","b":["mit den Backenzähnen","mit den Schneidezähnen","++mit den Eckzähnen"],"highlightSpanClass":"a"}]},{"trainer":"findZone","correctIconType":"check","onSamePage":true,"instruction":{"text":"Klicke auf die Eckzähne.","speaker":true},"lsg":{"lsg":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Gebiss-copy.lsg","width":250},"atoms":{"a":"","class":"Eckzähne"}},{"trainer":"multipleChoice","onSamePage":true,"instruction":{"text":"Womit zermahlt der Maulwurf seine Beute dann?","speaker":true},"atoms":{"b":["++mit den Backenzähnen","mit den Schneidezähnen","mit den Eckzähnen"]}},{"trainer":"findZone","correctIconType":"check","onSamePage":true,"instruction":{"text":"Klicke auf die Backenzähne.","speaker":true},"lsg":{"lsg":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Gebiss-copy.lsg","width":250},"atoms":{"a":"","class":"Backenzähne"}}],"parentTopic":{"title":"Nutz-, Haus- und Wildtiere","path":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/topic","puid":"c-bio-5/1ezxrd"},"parentBlock":{"title":"Maulwürfe","path":"/../c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/block","puid":"c-bio-5/omv9p4"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5/Beschrifte das Skelett des Maulwurfs.","etag":"d6cb-11235"},{"fileId":"sound/de/f5/Klicke auf das Sichelbein.","etag":"2b43-7776"},{"fileId":"sound/de/f5/Klicke auf die Backenzähne.","etag":"e6de-8349"},{"fileId":"sound/de/f5/Klicke auf die Eckzähne.","etag":"07f8-8012"},{"fileId":"sound/de/f5/Lies den Text und beantworte die Fragen.","etag":"8fdc-12645"},{"fileId":"sound/de/f5/Wie kann man die Körperform des Maulwurfs am ehesten beschreiben?","etag":"1537-17475"},{"fileId":"sound/de/f5/Womit zermahlt der Maulwurf seine Beute dann?","etag":"b024-13003"},{"fileId":"sound/de/f5/Wähle alle richtigen Aussagen aus.","etag":"1ffd-12014"},{"fileId":"sound/de/m3/Beinknochen","etag":"c6e5-4162"},{"fileId":"sound/de/m3/Der <b>walzenförmige Körper</b> des Maulwurfs ist an das Leben in den engen Bodengängen angepasst. Das gilt auch für seine Hände. Neben den fünf Fingerknochen verbreitert ein zusätzlicher Knochen, das <span class=a><b>Sichelbein</b></span>, die Handfläche. So kann der Maulwurf <span class=b>mehr Erde auf einmal schaufeln.</span>","etag":"ae45-76828"},{"fileId":"sound/de/m3/Der Maulwurf hat ein typisches <b>Insektenfressergebiss</b>. Mit den auffällig großen <span class=a><b>Eckzähnen</b></span> tötet er seine Beute, zu der vor allem <b>Regenwürmer</b> gehören. Mit den spitzen Backenzähnen zerkleinert er sie dann, bevor er sie schluckt.","etag":"4a2d-61095"},{"fileId":"sound/de/m3/Es können mehrere Antworten richtig sein.","etag":"c5fe-12355"},{"fileId":"sound/de/m3/Handknochen","etag":"042f-4578"},{"fileId":"sound/de/m3/Rippen","etag":"adf4-2654"},{"fileId":"sound/de/m3/Schädel","etag":"d8f2-3408"},{"fileId":"sound/de/m3/Wie nennt man den zusätzlichen Knochen an der Hand des Maulwurfs?","etag":"1057-17843"},{"fileId":"sound/de/m3/Wirbelsäule","etag":"9728-5279"},{"fileId":"sound/de/m3/Womit tötet der Maulwurf seine Beute?","etag":"fcf2-11627"},{"fileId":"sound/de/m3/Wozu dient das Sichelbein?","etag":"5bc2-7622"}],"svgs":[],"lsgs":[{"fileId":"lsg/c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/01_Walze_Kugel_Wuerfel.lsg","etag":"e08b-709"},{"fileId":"lsg/c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Gebiss-copy.lsg","etag":"5d7c-569"},{"fileId":"lsg/c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Gebiss.lsg","etag":"b28f-1051"},{"fileId":"lsg/c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Hand-copy.lsg","etag":"71c9-312"},{"fileId":"lsg/c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Hand.lsg","etag":"e756-404"},{"fileId":"lsg/c-bio-5/topic-02-nutz-haus-und-wildtiere/block-09-maulwurf/lsg/02_Skelett-LSG.lsg","etag":"6bdc-2630"}],"images":[{"fileId":"image/adobe_11239306","etag":"7f84-28319","originalWidth":707,"originalHeight":500},{"fileId":"image/adobe_13618138_06","etag":"caa0-245071","originalWidth":1035,"originalHeight":500},{"fileId":"image/adobe_249827356_01","etag":"2f47-5752","originalWidth":215,"originalHeight":204},{"fileId":"image/adobe_249827356_02","etag":"2598-6835","originalWidth":200,"originalHeight":182},{"fileId":"image/adobe_249827356_03","etag":"b4f5-4105","originalWidth":187,"originalHeight":193},{"fileId":"image/adobe_358954452_01","etag":"35f2-86634","originalWidth":500,"or