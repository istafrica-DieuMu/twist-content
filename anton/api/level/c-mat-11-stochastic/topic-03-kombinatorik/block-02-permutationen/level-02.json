{"title":"Rechnen mit Fakultäten (2)","puid":"c-mat-11-stochastic/wsrmt5","path":"/../c-mat-11-stochastic/topic-03-kombinatorik/block-02-permutationen/level-02","type":"normal","keyboardLayout":"standardDE","voiceLang":"de","voice":"m3_2025","instruction":{"voice":"f5_2025","speaker":true,"autoplay":false},"hint":{"label":"Hilfe","text":[{"text":"<t-yellow><m-yellow><b>&nbsp;Grundlagen&nbsp;</b></m-yellow></t-yellow>"},{"text":"Das Produkt aller natürlichen Zahlen von <mat>n</mat> bis <mat>1</mat> bezeichnet man als <b><mat>n</mat> Fakultät</b>. <br>In Rechnungen wird dies mit <b><mat>n!</mat></b> abgekürzt. <br>"},{"text":"<b>Beispiel:</b>"},{"text":"<mat center='true' align='rcl'>1!||=||1<br>2!||=||2*1=2<br>3!||=||3*2*1=6<br>4!||=||4*3*2*1=24<br>5!||=||5*4*3*2*1=120<br>6!||=||6*5*4*3*2*1=720</mat>"},{"text":"Die Null ist ein Spezialfall, für den definiert wurde: <mat>0! = 1</mat>."}]},"trainers":[{"trainer":"multipleChoice","instruction":{"text":"Forme geschickt um, um die Rechnung zu vereinfachen.","speaker":true},"shuffleButtons":true,"onSamePage":true,"atoms":{"a":"Wie können wir <mat>(11!)/(9!)</mat> noch darstellen?","b":["++<mat>(11*10*9!)/(9!)</mat> ","<mat>(11-9)!</mat>","<mat>(11/9)!</mat>","<mat>(11!*10!*9!)/(9!)</mat>"]}},{"trainer":"multipleChoice","shuffleButtons":true,"onSamePage":true,"atoms":{"a":"Kürze jetzt <mat>(11*10*9!)/(9!)</mat>. Was erhältst du?","b":["++<mat>11*10</mat>","<mat>2!</mat>","<mat>11!*10!</mat>","<mat>(11*10)/(9!)</mat>"]}},{"trainer":"multipleChoice","shuffleButtons":true,"onSamePage":true,"atoms":{"a":"Berechne jetzt <mat>(11!)/(9!)</mat>.","b":["++<mat>110</mat>","<mat>100</mat>","<mat>21</mat>"]}},{"trainer":"gapMulti","instruction":"Vereinfache die Rechnungen geschickt.","gapMode":"buttons","onSamePage":true,"textAlign":"left","shuffleButtons":true,"atoms":[{"b":"<mat center='true'>(5!)/(4!)=<gap>++5 4 1</gap></mat>"},{"b":"<mat center='true'>(7!)/(5!)=<gap>++7*6 7*6! 2!</gap></mat>"},{"b":"<mat center='true'>(10!*3!)/(2!*10!)=<gap>++3 3! 2 1</gap></mat>"},{"b":"<mat center='true'>(120!)/(119!)=<gap>++120 119! 1</gap></mat>"},{"b":"<mat center='true'>(20!)/(19!*2!)=<gap>++10 (10!)/(19!) 1</gap></mat>"},{"b":"<mat center='true'>13*12*11*10*9!=<gap>++13! 4320 (26!)/2</gap></mat>"},{"b":"<mat center='true'>1!*0!=<gap>0 ++1</gap></mat>"}]},{"trainer":"dragMatch","instruction":{"text":"Finde Paare mit gleichem Wert."},"onSamePage":true,"atoms":[{"a":"<mat>1!</mat>","b":"<mat>0!</mat>"},{"a":"<mat>4!</mat>","b":"<mat>24</mat>"},{"a":"<mat>5*4!</mat>","b":"<mat>5!</mat>"},{"a":"<mat>100*99*98!</mat>","b":"<mat>100!</mat>"},{"a":"<mat>(6!)/(5!)</mat>","b":"<mat>6</mat>"}]}],"parentTopic":{"title":"Kombinatorik","path":"/../c-mat-11-stochastic/topic-03-kombinatorik/topic","puid":"c-mat-11-stochastic/hl0cvy"},"parentBlock":{"title":"Permutationen","path":"/../c-mat-11-stochastic/topic-03-kombinatorik/block-02-permutationen/block","puid":"c-mat-11-stochastic/kvgabk"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5_2025/Finde Paare mit gleichem Wert.","etag":"a158-9308"},{"fileId":"sound/de/f5_2025/Forme geschickt um, um die Rechnung zu vereinfachen.","etag":"19bb-13941"},{"fileId":"sound/de/f5_2025/Vereinfache die Rechnungen geschickt.","etag":"8963-9648"}],"svgs":[],"lsgs":[],"images":[]},"etag":"560c-3308"}