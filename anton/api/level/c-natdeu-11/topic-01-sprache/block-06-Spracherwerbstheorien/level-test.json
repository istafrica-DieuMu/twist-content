smusdragmatch.lsg","width":160},"correct":false}]},{"a":"Der Sprach&shy;erwerb ist Teil der kognitiven Ent&shy;wick&shy;lung und folgt bestimm&shy;ten Phasen.","b":[{"lsg":{"lsg":"/../c-natdeu-11/topic-01-sprache/block-06-Spracherwerbstheorien/lsgs/Nativismusdragmatch.lsg","width":160},"correct":false},{"lsg":{"lsg":"/../c-natdeu-11/topic-01-sprache/block-06-Spracherwerbstheorien/lsgs/Behaviorismusdragmatch.lsg","width":160},"correct":false},{"lsg":{"lsg":"/../c-natdeu-11/topic-01-sprache/block-06-Spracherwerbstheorien/lsgs/Kognitivismusdragmatch.lsg","width":160},"correct":true}]}]},{"trainer":"imageButtons","instruction":{"text":"Zu welcher Spracherwerbstheorie gehört die jeweilige Aussage? Ordne zu.","speaker":true,"autoplay":false},"shuffleAtoms":true,"shuffleButtons":false,"atoms":[{"a":"Die Sprache eines Kindes entwickelt sich vor allem durch die Inter&shy;aktion mit seinen Bezugs&shy;personen.","b":[{"lsg":{"lsg":"/../c-natdeu-11/topic-01-sprache/block-06-Spracherwerbstheorien/lsgs/Interaktionismusdragmatch.lsg","width":160},"correct":true},{"lsg":{"lsg":"/../c-natdeu-11/topic-01-sprache/block-06-Spracherwerbstheorien/lsgs/Konstruktivismusdragmatch.lsg","width":160},"correct":false}]},{"a":"Der Sprach&shy;erwerb ist das Resultat des Zusammen&shy;wirkens von inneren Voraus&shy;setzungen und Umwelt&shy;faktoren.","b":[{"lsg":{"lsg":"/../c-natdeu-11/topic-01-sprache/block-06-Spracherwerbstheorien/lsgs/Interaktionismusdragmatch.lsg","width":160},"correct":false},{"lsg":{"lsg":"/../c-natdeu-11/topic-01-sprache/block-06-Spracherwerbstheorien/lsgs/Konstruktivismusdragmatch.lsg","width":160},"correct":true}]}]},{"trainer":"buttons","instruction":{"text":"Ordne die Beispiele der passenden Spracherwerbstheorie zu.","speaker":true},"shuffleButtons":false,"shuffleAtoms":true,"soundMode":"b","atoms":[{"a":"Bernd spielt mit seiner 8 Monate alten Tochter. Dabei verändert er seine Stimmlage und benutzt besonders kurze, einfach formulierte Sätze.","b":"++Interaktionismus Behaviorismus Kognitivismus Nativismus Konstruktivismus"},{"a":"Beim Frühstück äußert Nael plötzlich den Satz „Ich hab das aufgeesst“, obwohl er diesen Satz vorher noch nicht gehört hat.","b":"Interaktionismus Behaviorismus Kognitivismus ++Nativismus Konstruktivismus"},{"a":"Kateryna entwickelt eine Vorstellung davon, was Wasser ist, indem sie es sieht, anfasst und probiert. Sie sagt zunächst „Wasser“ und später „Ich will Wasser trinken.“","b":"Interaktionismus Behaviorismus ++Kognitivismus Nativismus Konstruktivismus"},{"a":"Cho sagt zu ihrem Bruder Akaya: „Komm, wir schauen uns ein Buch an.“ Akaya wiederholt: „Schauen Buch an.“ Cho nickt bestätigend und antwortet: „Ja, wir schauen uns ein spannendes Buch an.“","b":"Interaktionismus ++Behaviorismus Kognitivismus Nativismus Konstruktivismus"},{"a":"Hannah, deren Eltern Schauspieler sind, und Jeremy, dessen Vater Maler ist, lernen in der Kita Wasserfarben kennen. Als die Kinder einige Wochen später gefragt werden, wozu sie Farben benutzen können, antwortet Hannah: „Um das Gesicht anzumalen“, und Jeremy: „Für das Streichen.“","b":"Interaktionismus Behaviorismus Kognitivismus Nativismus ++Konstruktivismus"}]}],"parentTopic":{"title":"Sprache","path":"/../c-natdeu-11/topic-01-sprache/topic","puid":"c-natdeu-11/qakt0s"},"parentBlock":{"title":"Spracherwerbstheorien","path":"/../c-natdeu-11/topic-01-sprache/block-06-Spracherwerbstheorien/block","puid":"c-natdeu-11/1gxww8"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5/Ordne die Beispiele der passenden Spracherwerbstheorie zu.","etag":"2166-17609"},{"fileId":"sound/de/f5/Setze das gesuchte Wort zusammen.","etag":"3865-11365"},{"fileId":"sound/de/f5/Ziehe die Begriffe an die richtige Stelle im Merkzettel zur behavioristischen Spracherwerbstheorie.","etag":"22c2-28301"},{"fileId":"sound/de/f5/Ziehe die Begriffe an die richtige Stelle im Merkzettel zur interaktionistischen Spracherwerbstheorie.","etag":"070a-29859"},{"fileId":"sound/de/f5/Ziehe die Begriffe an die richtige Stell