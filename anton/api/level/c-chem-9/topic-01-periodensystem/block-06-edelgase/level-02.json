 aus.","etag":"342c-23622"},{"fileId":"sound/en/f3/Here is a possible solution","etag":"b4e9-9282"},{"fileId":"sound/en/f8Us/Here is a possible solution","etag":"d344-9235"},{"fileId":"sound/es/f1EsUs/Esta es una solución posible","etag":"1722-12113"},{"fileId":"sound/fr/f1/Voici une solution","etag":"58d3-6084"},{"fileId":"sound/pt/f6/Aqui você pode ver uma possível solução","etag":"c2c1-20592"}],"svgs":[{"fileId":"svg/c-chem-9/topic-01-periodensystem/block-06-edelgase/lsg/argon.svg","etag":"860e-6897"},{"fileId":"svg/c-chem-9/topic-01-periodensystem/block-06-edelgase/lsg/helium.svg","etag":"b511-6900"},{"fileId":"svg/c-chem-9/topic-01-periodensystem/block-06-edelgase/lsg/krypton.svg","etag":"e8c4-6900"},{"fileId":"svg/c-chem-9/topic-01-periodensystem/block-06-edelgase/lsg/neon.svg","etag":"bc9e-6876"},{"fileId":"svg/c-chem-9/topic-01-periodensystem/block-06-edelgase/lsg/xenon.svg","etag":"423a-6895"},{"fileId":"svg/c-svg/2022/05/27-blue-balloon.svg","etag":"9bfb-13491"},{"fileId":"svg/c-svg/2022/05/27-green-balloon.svg","etag":"64a7-13327"},{"fileId":"svg/c-svg/2022/05/27-purple-balloon.svg","etag":"1e5d-2425"},{"fileId":"svg/c-svg/2023/01/27-tape-02.svg","etag":"6c13-1199"},{"fileId":"svg/c-svg/2023/07/06-table.svg","etag":"fb11-590"},{"fileId":"svg/c-svg/2024/11/27-atom-model-3d-sphere-01.svg","etag":"eff8-1284"},{"fileId":"svg/c-svg/2025/07/11-hand-scissors.svg","etag":"171b-11450"}],"lsgs":[{"fileId":"lsg/c-chem-9/resources/modelle/atommodell-dalton-lsgs-massstab/sauerstoff_molekuel.lsg","etag":"187a-422"},{"fileId":"lsg/c-chem-9/resources/modelle/atommodell-dalton-lsgs-massstab/stickstoff_molekuel.lsg","etag":"b4f1-418"},{"fileId":"lsg/c-chem-9/resources/pse/elements/argon.lsg","etag":"ca66-563"},{"fileId":"lsg/c-chem-9/resources/pse/elements/helium.lsg","etag":"c2b1-562"},{"fileId":"lsg/c-chem-9/resources/pse/elements/krypton.lsg","etag":"2939-565"},{"fileId":"lsg/c-chem-9/resources/pse/elements/neon.lsg","etag":"ddee-562"},{"fileId":"lsg/c-chem-9/resources/