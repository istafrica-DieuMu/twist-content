{"title":"Kreisdiagramme zeichnen","puid":"c-mat-7/rpl40n","path":"/../c-mat-7/topic-07-wahrscheinlichkeit/block-01-diagramme-tabellen-lesen/level-03","type":"normal","minLevelPlayerVersion":"v1.2","voiceLang":"de","keyboardLayout":"numbersComma","textAlign":"left","lsg":{"width":400},"voice":"f5","instruction":{"voice":"m3"},"trainers":[{"trainer":"gapMulti","gapMode":"buttons","instruction":{"text":"Fülle die Lücken.","speaker":true},"textAlign":"center","shuffleButtons":true,"shuffleAtoms":false,"lsg":{"width":300},"atoms":[{"a":"","b":"Ein Kreis hat ((180 ++360))°. Die farbigen Kreissektoren, die an Tortenstücke erinnern, stehen jeweils für einen ((Gesamtwert ++Teilwert)). Die Summe aller Teilwerte, also der volle Kreis, symbolisiert den ((++Gesamtwert Prozentsatz)).","lsg":"/../c-mat-7/topic-07-wahrscheinlichkeit/block-01-diagramme-tabellen-lesen/lsg/kreisohne.lsg"},{"a":"","b":"Um einen Anteil in einem Kreisdiagramm darzustellen, muss man die Größe des Kreisausschnitts, also den Winkel des Anteils, ermitteln. Da der volle Kreis von 360° 100 % entspricht, entsprechen 1 % ((++3,6° 36°))."},{"a":"","b":"Der Winkel für einen Anteil wird berechnet, indem man den entsprechenden ((Gesamtwert ++Teilwert)) durch den ((++Gesamtwert Teilwert)) dividiert und mit 360° ((addiert ++multipliziert)).","lsg":"/../c-mat-7/topic-07-wahrscheinlichkeit/block-01-diagramme-tabellen-lesen/lsg/kreisformel.lsg"}]},{"trainer":"table","gapMode":"write","instruction":{"text":"Ergänze die Tabelle zur Berechnung der Winkel.","speaker":true},"shuffleButtons":false,"combineButtons":true,"finishButton":true,"columnHeader":true,"layout":"a1 b1\na2 b2\na3 b3\na4 b4\na5 b5","lsg":"/../c-mat-7/topic-07-wahrscheinlichkeit/block-01-diagramme-tabellen-lesen/lsg/kreisdiagramm3.lsg","atoms":[{"id":"a1","b":"Anzahl"},{"id":"b1","b":"Winkel"},{"id":"a2","b":"10"},{"id":"b2","b":"<mat>(10 : 100) * 360° = <gap>36</gap>°</mat>"},{"id":"a3","b":"20"},{"id":"b3","b":"<mat>(<gap>20</gap> : 100) * <gap>360</gap>° = 72°</mat>"},{"id":"a4","b":"30"},{"id":"b4","b":"<mat>(30 : <gap>100</gap>) * <gap>360</gap>° = 108°</mat>"},{"id":"a5","b":"40"},{"id":"b5","b":"<mat>(<gap>40</gap> : 100) * 360° = 144°</mat>"}]}],"parentTopic":{"title":"Wahrscheinlichkeit","path":"/../c-mat-7/topic-07-wahrscheinlichkeit/topic","puid":"c-mat-7/xyojnp"},"parentBlock":{"title":"Diagramme und Tabellen","path":"/../c-mat-7/topic-07-wahrscheinlichkeit/block-01-diagramme-tabellen-lesen/block","puid":"c-mat-7/grjc6o"},"mediaFiles":{"sounds":[{"fileId":"sound/de/m3/Ergänze die Tabelle zur Berechnung der Winkel.","etag":"2dfa-12928"},{"fileId":"sound/de/m3/Fülle die Lücken.","etag":"0f29-5125"}],"svgs":[],"lsgs":[{"fileId":"lsg/c-mat-7/topic-07-wahrscheinlichkeit/block-01-diagramme-tabellen-lesen/lsg/kreisdiagramm3.lsg","etag":"4ade-2170"},{"fileId":"lsg/c-mat-7/topic-07-wahrscheinlichkeit/block-01-diagramme-tabellen-lesen/lsg/kreisformel.lsg","etag":"90b4-682"},{"fileId":"lsg/c-mat-7/topic-07-wahrscheinlichkeit/block-01-diagramme-tabellen-lesen/lsg/kreisohne.lsg","etag":"b95a-316"},{"fileId":"lsg/c-renderer/pieChart/renderer.lsr"}],"images":[]},"etag":"7011-3169"}