{"title":"<i>Describing relationships</i> (2)","puid":"c-eng-9/vvfe7o","path":"/../c-eng-9/topic-03-everyone-is-unique/block-01-describing-people-and-relationships/level-04","type":"normal","voiceLang":"en","voice":"m2","keyboardLayout":"standardENG","instruction":{"voiceLang":"de","voice":"f5"},"image":{"width":200},"lsg":{"width":200},"trainers":[{"trainer":"dragCard","instruction":{"text":"Höre zu und lies mit.","speaker":true},"soundMode":"b","voiceLang":"en","atoms":[{"a":"jmd./etw. beurteilen","b":"to judge sb./sth.","sound":"to judge somebody/something"},{"a":"jmd./etw. respektieren","b":"to respect sb./sth.","sound":"to respect somebody/something"},{"a":"jmd./etw. beeinflussen","b":"to influence sb./sth.","sound":"to influence somebody/something"},{"a":"etw. trennen","b":"to separate sth.","sound":"to separate something"}]},{"trainer":"memory","instruction":{"text":"Tippe die passende Übersetzung an.","speaker":true},"chooseMode":"text","soundMode":"b","voiceLang":"en","atoms":[{"a":"<i>jmd./etw. beurteilen</i>","b":"to judge sb./sth.","sound":"to judge somebody, something"},{"a":"<i>jmd./etw. respektieren</i>","b":"to respect sb./sth.","sound":"to respect somebody, something"},{"a":"<i>jmd./etw. beeinflussen</i>","b":"to influence sb./sth.","sound":"to influence somebody, something"},{"a":"<i>etw. trennen</i>","b":"to separate sth.","sound":"to separate somebody, something"}]},{"trainer":"multipleChoice","instruction":{"text":"Wähle die richtige Übersetzung des Satzes aus.","speaker":true},"soundMode":"b","voiceLang":"en","shuffleButtons":true,"shuffleAtoms":true,"atoms":[{"a":"<i>Er beurteilt ein Buch nie nach seinem Einband.</i>","b":["++He never judges a book by its cover.","He never separates a book from its cover."],"image":"adobe_307271823_crop-2637-0-5301-5301"},{"a":"<i>Wir müssen die Meinung anderer Menschen respektieren.</i>","b":["++We must respect other people's opinion.","We must influence others to have the same opinion as we do."],"image":"adobe_90899777"},{"a":"<i>Ihre Liebe zu Tieren und zur Umwelt hat sie dazu gebracht, Veganerin zu werden.</i>","b":["++Her love for animals and for the environment influenced her to become vegan.","She can separate her love for animals and for the environment from her eating habits."],"image":"adobe_268158053_crop-1421-0-3840-3840"},{"a":"<i>Wir müssen Fakten von Falschmeldungen trennen.</i>","b":["++We need to separate facts from fake news.","We have to judge every single thing we read."],"image":"adobe_537976439_crop-13-0-5301-5301"}]},{"trainer":"dragCard","instruction":{"text":"Höre zu und lies mit.","speaker":true},"soundMode":"b","voiceLang":"en","atoms":[{"a":"bei etw. behilflich sein","b":"to assist with sth.","sound":"to assist with something"},{"a":"mit etw. nicht einverstanden sein","b":"to disapprove of sth.","sound":"to disapprove of something"},{"a":"etw. teilen","b":"to share sth.","sound":"to share something"},{"a":"sich über etw./jmd. beschweren","b":"to complain about sth./sb.","sound":"to complain about somebody or something"}]},{"trainer":"gap","gapMode":"buttons","instruction":{"text":"Übersetze die Sätze, indem du die jeweils passenden Verben auswählst.","speaker":true},"soundMode":"b","voiceLang":"en","shuffleButtons":true,"shuffleAtoms":true,"atoms":[{"a":"<i>Sie beschwert sich oft über den Lärm ihrer Nachbarn.</i>","b":"She often ((++complains assists disapproves shares)) about the noises from her neighbours.","image":"adobe_495363095_crop-279-0-3886-3886"},{"a":"<i>Er war seinem Vater bei den Vorbereitungen für das Abendessen behilflich.</i>","b":"He ((complained ++assisted disapproved_of shared)) his father with the dinner preparations.","image":"adobe_203718128_crop-47-0-4016-4016"},{"a":"<i>Ich bin mit der Wahl unserer neuen Wandfarbe nicht einverstanden.</i>","b":"I ((complain assist_with ++disapprove_of share)) the choice of our new wall colour.","image":"adobe_204161463_crop-385-0-4667-4667"},{"a":"<i>Ich teile mein Essen oft mit meinem besten Freund.</i>","b":"I often ((complain assist_with disapprove_of ++share)) my food with my best friend.","image":"adobe_299735621"}]}],"parentTopic":{"title":"Everyone is unique","path":"/../c-eng-9/topic-03-everyone-is-unique/topic","puid":"c-eng-9/18n1du"},"parentBlock":{"title":"Describing people and relationships","path":"/../c-eng-9/topic-03-everyone-is-unique/block-01-describing-people-and-relationships/block","puid":"c-eng-9/uswy4u"},"mediaFiles":{"sounds":[{"fileId":"sound/de/f5/Höre zu und lies mit.","etag":"26c1-8350"},{"fileId":"sound/de/f5/Tippe die passende Übersetzung an.","etag":"7fe9-11236"},{"fileId":"sound/de/f5/Wähle die richtige Übersetzung des Satzes aus.","etag":"f063-15292"},{"fileId":"sound/de/f5/Übersetze die Sätze, indem du die jeweils passenden Verben auswählst.","etag":"b8ba-22652"},{"fileId":"sound/en/m2/He assisted his father with the dinner preparations.","etag":"13fe-14149"},{"fileId":"sound/en/m2/He never judges a book by its cover.","etag":"2f82-9831"},{"fileId":"sound/en/m2/Her love for animals and for the environment influenced her to become vegan.","etag":"5865-18851"},{"fileId":"sound/en/m2/I disapprove of the choice of our new wall colour.","etag":"6ee5-12458"},{"fileId":"sound/en/m2/I often share my food with my best friend.","etag":"5176-12144"},{"fileId":"sound/en/m2/She often complains about the noises from her neighbours.","etag":"ee3e-14280"},{"fileId":"sound/en/m2/We must respect other people's opinion.","etag":"6806-10324"},{"fileId":"sound/en/m2/We need to separate facts from fake news.","etag":"12e7-12743"},{"fileId":"sound/en/m2/to assist with something","etag":"0783-6294"},{"fileId":"sound/en/m2/to complain about somebody or something","etag":"84ab-10922"},{"fileId":"sound/en/m2/to disapprove of something","etag":"f568-7178"},{"fileId":"sound/en/m2/to influence somebody, something","etag":"63e2-9599"},{"fileId":"sound/en/m2/to influence somebody/something","etag":"06a7-9103"},{"fileId":"sound/en/m2/to judge so